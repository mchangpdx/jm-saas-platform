# Server (서버 설정)
PORT=3000
NODE_ENV=development

# Supabase (Supabase 설정)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# Redis / BullMQ (레디스 설정)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# External Adapters — Payment (외부 결제 어댑터 키)
STRIPE_SECRET_KEY=sk_test_...
# Public-facing base URL used to build payment links in emails/SMS (이메일/SMS 결제 링크 생성에 사용되는 공개 베이스 URL)
# Development: set to your Ngrok HTTPS URL, e.g. https://abc123.ngrok-free.app (개발: Ngrok HTTPS URL로 설정)
# Production:  set to your real domain, e.g. https://yourdomain.com (프로덕션: 실제 도메인으로 설정)
SERVER_URL=https://abc123.ngrok-free.app

# Maverick / Dejavoo Mock Controls (Maverick/Dejavoo 목 제어)
# MOCK_DECLINE_RATE=0.0   — 0.0 = always approve, 0.1 = 10% decline rate (0.0=항상승인, 0.1=10% 거절)

# External Adapters — POS (외부 POS 어댑터 키)
TOAST_API_KEY=
TOAST_API_SECRET=

# LLM — Google Gemini (LLM — Google Gemini 설정)
GEMINI_API_KEY=AIza...

# Retell AI — WebSocket LLM server (Retell AI WebSocket LLM 서버)
# Required to fetch the caller's phone number via REST on each new call.
# Without this key, CRM personalisation is skipped but the AI still responds.
# Find your API key at: https://dashboard.retellai.com → Settings → API Keys
# (각 통화 시 REST로 발신자 전화번호 취득에 필요. 미설정 시 CRM 개인화 생략, AI 응답은 정상)
RETELL_API_KEY=key_...
# LOYVERSE_TIMEOUT_MS=8000   — Loyverse HTTP request timeout in ms (Loyverse HTTP 요청 타임아웃, 기본 8초)

# Notifications — Nodemailer SMTP (이메일 알림 — Nodemailer SMTP 설정)
# If unset, email falls back to mock console.warn (미설정 시 목 콘솔 경고로 폴백)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=JM Restaurant

# Notifications — Twilio SMS (SMS 알림 — Twilio 설정)
# If unset, SMS falls back to mock console.warn (미설정 시 목 콘솔 경고로 폴백)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+15005550006
